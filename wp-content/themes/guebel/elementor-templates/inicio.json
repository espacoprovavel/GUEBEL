            "id": "wid_contact_form",
            "elType": "widget",
            "widgetType": "html",
            "settings": {
              "html": "<form action=\"mailto:geral@guebel.pt\" method=\"post\" enctype=\"text/plain\" class=\"guebel-hp-form\">\n  <div class=\"ghf-row\">\n    <input type=\"text\" name=\"nome\" placeholder=\"O SEU NOME\" required>\n    <input type=\"email\" name=\"email\" placeholder=\"O SEU EMAIL\" required>\n  </div>\n  <input type=\"tel\" name=\"telefone\" placeholder=\"O SEU TELEFONE\">\n  <input type=\"text\" name=\"mensagem\" placeholder=\"A SUA MENSAGEM\">\n  <button type=\"submit\">ENVIAR</button>\n</form>\n<style>\n.guebel-hp-form{display:flex;flex-direction:column;gap:26px;max-width:460px;}\n.guebel-hp-form .ghf-row{display:flex;gap:26px;flex-wrap:wrap;}\n.guebel-hp-form .ghf-row input{flex:1 1 160px;}\n.guebel-hp-form input{border:none;border-bottom:1px solid #cfc6ac;background:transparent;padding:10px 0;font-family:'Work Sans',sans-serif;font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:#33604e;}\n.guebel-hp-form input::placeholder{color:#9aa39a;letter-spacing:0.2em;}\n.guebel-hp-form input:focus{outline:none;border-color:#33604e;}\n.guebel-hp-form button{align-self:flex-start;margin-top:10px;background:transparent;border:1px solid #33604e;color:#33604e;padding:14px 46px;font-family:'Work Sans',sans-serif;font-size:11px;font-weight:500;letter-spacing:0.28em;text-transform:uppercase;cursor:pointer;transition:opacity .3s;}\n.guebel-hp-form button:hover{opacity:.65;}\n</style>"
            }
