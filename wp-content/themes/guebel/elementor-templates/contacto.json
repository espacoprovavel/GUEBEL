      {
        "id": "col_contacto_form",
        "elType": "column",
        "settings": {
          "_column_size": 50
        },
        "elements": [
          {
            "id": "wid_contacto_form_text",
            "elType": "widget",
            "widgetType": "html",
            "settings": {
              "html": "<form data-guebel-contact class=\"guebel-hp-form\">\n  <div class=\"ghf-row\">\n    <input type=\"text\" name=\"name\" placeholder=\"O SEU NOME\" required>\n    <input type=\"email\" name=\"email\" placeholder=\"O SEU EMAIL\" required>\n  </div>\n  <input type=\"tel\" name=\"phone\" placeholder=\"O SEU TELEFONE\">\n  <input type=\"text\" name=\"message\" placeholder=\"A SUA MENSAGEM\" required>\n  <label class=\"ghf-consent\"><input type=\"checkbox\" name=\"consent\" value=\"1\" required> <span>Aceito a <a href=\"/privacidade/\">Política de Privacidade</a> e o tratamento dos meus dados para resposta a este contacto.</span></label>\n  <label class=\"ghf-consent\"><input type=\"checkbox\" name=\"marketing\" value=\"1\"> <span>Quero receber novidades e ofertas da Guebel por email.</span></label>\n  <button type=\"submit\">ENVIAR</button>\n</form>\n<style>\n.guebel-hp-form{display:flex;flex-direction:column;gap:22px;max-width:460px;}\n.guebel-hp-form .ghf-row{display:flex;gap:26px;flex-wrap:wrap;}\n.guebel-hp-form .ghf-row input{flex:1 1 160px;}\n.guebel-hp-form input[type=text],.guebel-hp-form input[type=email],.guebel-hp-form input[type=tel]{border:none;border-bottom:1px solid #cfc6ac;background:transparent;padding:10px 0;font-family:'Work Sans',sans-serif;font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:#33604e;}\n.guebel-hp-form input::placeholder{color:#9aa39a;letter-spacing:0.2em;}\n.guebel-hp-form input:focus{outline:none;border-color:#33604e;}\n.guebel-hp-form .ghf-consent{display:flex;align-items:flex-start;gap:8px;font-family:'Work Sans',sans-serif;font-size:12px;line-height:1.5;color:#6f7f77;text-transform:none;letter-spacing:0;}\n.guebel-hp-form .ghf-consent input{margin-top:3px;flex-shrink:0;accent-color:#33604e;}\n.guebel-hp-form .ghf-consent a{color:#33604e;text-decoration:underline;}\n.guebel-hp-form button{align-self:flex-start;margin-top:10px;background:transparent;border:1px solid #33604e;color:#33604e;padding:14px 46px;font-family:'Work Sans',sans-serif;font-size:11px;font-weight:500;letter-spacing:0.28em;text-transform:uppercase;cursor:pointer;transition:opacity .3s;}\n.guebel-hp-form button:hover{opacity:.65;}\n</style>"
            }
          }
