            "settings": {
              "editor": "<div style=\"color: #2d3a35; font-size: 15px; line-height: 2;\">\n<p><strong>Email:</strong> geral@guebel.pt</p>\n<p><strong>WhatsApp:</strong> +351 912 345 678</p>\n<p><strong>Horário:</strong> Segunda a Sexta, 10h – 18h</p>\n<p><strong>Morada:</strong> Lisboa, Portugal</p>\n</div>"
            }
          },
          {
            "id": "wid_contacto_redes",
            "elType": "widget",
            "widgetType": "text-editor",
            "settings": {
              "editor": "<p style=\"color: #7a8a82; font-size: 14px; margin-top: 20px;\">Siga-nos no Instagram e Pinterest para inspiração de decoração sustentável.</p>"
            }
          }
        ]
